# Supabase (for leads + subscribers)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email notifications on new lead)
RESEND_API_KEY=re_xxxx
INQUIRY_NOTIFY_EMAIL=hello@yourdomain.com
RESEND_FROM_EMAIL=Velora Studio <noreply@yourdomain.com>

# Admin dashboard (/admin/leads)
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=optional-separate-cookie-secret

# Calendly or Cal.com (Book a Free Strategy Call)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
# or
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/your-link

# Social links (footer; omit or leave empty to hide)
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# or
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
